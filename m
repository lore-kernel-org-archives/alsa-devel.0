> +				       "Room 3",
> +				       "Hall 1",
> +				       "Hall 2",
> +				       "Plate",
> +				       "Delay",
> +				       "Echo"
>  	};
>  
>  	uinfo->type = SNDRV_CTL_ELEM_TYPE_ENUMERATED;
> @@ -614,6 +614,13 @@ static int snd_ftu_eff_switch_get(struct snd_kcontrol *kctl,
