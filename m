> +static struct pci_driver driver = {
> + .name = "ALS300",
> + .id_table = snd_als300_ids,
> + .probe = snd_als300_probe,
> + .remove = __devexit_p(snd_als300_remove),
> +};
> +
> +static int __init alsa_card_als300_init(void)
> +{
