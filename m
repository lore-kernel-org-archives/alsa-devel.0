> +	printk(KERN_ERR SAA7146_SUBSYS_LOG_TAG ": %s:%d:" fmt "\n", \
> +					__func__, __LINE__, ## args);
> +# define LOG_WARN(fmt, args...) \
> +	printk(KERN_WARNING SAA7146_SUBSYS_LOG_TAG ": %s:%d:" fmt "\n", \
