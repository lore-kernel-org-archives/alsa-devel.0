Takashi

>=20
> # this makes native ALSA apps default to using dmix
> pcm.!default {
>   type plug
>   slave.pcm "duplex"
> }
>=20
> ctl.!default {
>   type hw
>   card 0
> }
>=20
> pcm.duplex{
>    type asym
>    playback.pcm "dmix0"
>    capture.pcm "plughw:0,0"
> }
>=20
> pcm.dmix0 {
>     type dmix
>     ipc_key 219345           # any unique number here
>     slave {
>             pcm "hw:0,0"
>             period_time 0
>             #buffer_time 0
>             period_size 2048    # jm: much smoother than 1024/8192!
>             buffer_size 32768
>             rate 44100
>     }   =20
>     bindings {
>         0 0   # from 0 =3D> to 0
>         1 1   # from 1 =3D> to 1
>     }
> }
