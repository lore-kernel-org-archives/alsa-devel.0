> +0800
> @@ -277,7 +277,10 @@
>   status = snd_bt87x_readl(chip, REG_INT_STAT);
>   irq_status = status & chip->interrupt_mask;
>   if (!irq_status)
> -  return IRQ_NONE;
> +          {
> +            snd_bt87x_writel (chip, REG_INT_STAT, status);
> +            return IRQ_NONE;
> +          }
>   snd_bt87x_writel(chip, REG_INT_STAT, irq_status);
>  
