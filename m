We prefer sound/driver.h in the head of includes.  Which makes easier
to build on 2.2/2.4 kernels, too.

> +#include <linux/delay.h>
> +#include <linux/init.h>
> +#include <linux/moduleparam.h>
> +#include <linux/pci.h>
> +#include <linux/interrupt.h>
> +#include <linux/slab.h>
> +
> +#include <asm/io.h>
> +
> +#include <sound/driver.h>
> +#include <sound/core.h>
> +#include <sound/control.h>
> +#define SNDRV_GET_ID

This define is obsolete.  Just drop.

> +typedef struct snd_als300 als300_t;
> +struct snd_als300 {
> + unsigned long port;
> + spinlock_t reg_lock;
> + snd_card_t *card;
> + struct pci_dev *pci;
> +
> +	snd_pcm_t *pcm;
> +	snd_pcm_substream_t *playback_substream;
> +	snd_pcm_substream_t *capture_substream;
> +
> +	ac97_t *ac97;
> +	opl3_t *opl3;

In the latest version, we dropped xxx_t style typedefs from overall
places.  Please replace them with struct xxx.  For example, snd_pcm_t
-> struct snd_pcm.  ac97_t and opl3_t will be struct snd_ac97 and
struct snd_opl3 (with snd_ prefix to be consistent).


> +static int snd_als300_playback_prepare(snd_pcm_substream_t *substream)
> +{
> + u32 tmp;
> + unsigned long flags;
> + als300_t *chip = snd_pcm_substream_chip(substream);
> + snd_pcm_runtime_t *runtime = substream->runtime;
> + unsigned short period_bytes = snd_pcm_lib_period_bytes(substream);
> + unsigned short buffer_bytes = snd_pcm_lib_buffer_bytes(substream);
> +	
> +	snd_als300_dbgcallenter();
> +	spin_lock_irqsave(&chip->reg_lock, flags);

In prepare callback, it's safe to use spin_lock_irq() (without save).
It can't be called from irq context.

> +static int snd_als300_trigger(snd_pcm_substream_t *substream, int cmd)
> +{
> + als300_t *chip = snd_pcm_substream_chip(substream);
> + u32 tmp;
> + unsigned long flags;
> + als300_substream_data_t *data = substream->runtime->private_data;
> + unsigned short reg = data->control_register;
> + int ret = 0;
> +
> + snd_als300_dbgcallenter();
> + spin_lock_irqsave(&chip->reg_lock, flags);

OTOH, trigger and pointer callbacks are always called inside
spin_lock_irqsave().  Thus, it's safe to use spin_lock() (without
_irq*).

> +static int __devinit snd_als300_new_pcm(als300_t *chip)
> +{
