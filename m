> +			UAC_GET_CUR,
> +			USB_TYPE_CLASS | USB_RECIP_ENDPOINT | USB_DIR_IN,
> +			UAC_EP_CS_ATTR_SAMPLE_RATE << 8,
> +			ep,
> +			data,
> +			sizeof(data));
> +	if (err < 0)
> +		goto end;
> +
> +	rate = data[0] | (data[1] << 8) | (data[2] << 16);
