 	depends on SND
 	select SND_AC97_CODEC
+	select SND_VMASTER
 	help
 	  Say Y here to include support for the integrated AC97 sound
 	  device on motherboards with Intel/SiS/nVidia/AMD chipsets, or
@@ -835,6 +837,7 @@ config SND_VIA82XX
