+		snd_ice1712_ews_init,
+		snd_ice1712_ews_add_controls,
+	},
+	{
+		ICE1712_SUBDEVICE_EWS88MT_NEW,
+		"TerraTec EWS 88MT (new)",
 		snd_ice1712_ews_init,
 		snd_ice1712_ews_add_controls,
 	},
