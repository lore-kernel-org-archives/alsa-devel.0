-		if (ret < 0) {
+	for (;;) {
+		int mode = SND_TIMER_OPEN_NONBLOCK;
+		if (dmix->tread)
+			mode |= SND_TIMER_OPEN_TREAD;
+		ret = snd_timer_open(&dmix->timer, name, mode);
+		if (ret >= 0)
+			break;
+		if (! dmix->tread) {
 			SNDERR("unable to open timer '%s'", name);
 			return ret;
 		}
+		dmix->tread = 0;
