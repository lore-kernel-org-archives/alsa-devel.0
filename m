>  			continue;
> -		} 
> +		}
>  		if (cfg->hp_outs > 0 &&
>  		    cfg->line_out_type == AUTO_PIN_SPEAKER_OUT) {
>  			cfg->speaker_outs = cfg->line_outs;
> @@ -3448,7 +3450,7 @@ static int alc_auto_fill_dac_nids(struct hda_codec *codec)
