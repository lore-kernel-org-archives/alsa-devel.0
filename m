--- a/pci/hda/patch_analog.c	Thu Jan 31 14:50:26 2008 +0100
+++ b/pci/hda/patch_analog.c	Thu Jan 31 16:14:30 2008 +0100
@@ -1406,7 +1406,10 @@ static int ad1981_hp_master_sw_put(struc
 
 	if (! ad198x_eapd_put(kcontrol, ucontrol))
 		return 0;
-
