+static int snd_emu10k1_pitch_info(snd_kcontrol_t *kcontrol, snd_ctl_elem_info_t * uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 4000;
+	uinfo->value.integer.max = 96000;
+	return 0;
+}
+
+static int snd_emu10k1_pitch_get(snd_kcontrol_t * kcontrol,
+				 snd_ctl_elem_value_t * ucontrol)
+{
+	emu10k1_pcm_mixer_t *mix = (emu10k1_pcm_mixer_t *)kcontrol->private_value;
+	emu10k1_t *emu = snd_kcontrol_chip(kcontrol);
+	unsigned long flags;
+
+	spin_lock_irqsave(&emu->reg_lock, flags);
+	ucontrol->value.integer.value[0] = mix->rate;
+	spin_unlock_irqrestore(&emu->reg_lock, flags);
+        return 0;
+}
+
+static unsigned int emu10k1_calc_pitch_target(unsigned int rate)
+{
+	unsigned int pitch_target;
+
+	pitch_target = (rate << 8) / 375;
+	pitch_target = (pitch_target >> 1) + (pitch_target & 1);
+	return pitch_target;
+}
+
+static int snd_emu10k1_pitch_put(snd_kcontrol_t * kcontrol,
+				snd_ctl_elem_value_t * ucontrol)
+{
+	unsigned long flags;
+	emu10k1_pcm_mixer_t *mix = (emu10k1_pcm_mixer_t *)kcontrol->private_value;
+	emu10k1_t *emu = snd_kcontrol_chip(kcontrol);
+	int change = 0, val;
+	unsigned int pitch_target;
+
+	val = ucontrol->value.integer.value[0];
+	if (val < 4000 || val > 96000)
+		return -EINVAL;
+	spin_lock_irqsave(&emu->reg_lock, flags);
+	if (mix->rate != val) {
+		mix->rate = val;
+		change = 1;
+	}
+	if (change && mix->epcm) {
+		mix->epcm->substream->runtime->rate = mix->rate;
+		pitch_target = emu10k1_calc_pitch_target(val);
+		if (mix->epcm->voices[0])
+			snd_emu10k1_ptr_write(emu, PTRX_PITCHTARGET, mix->epcm->voices[0]->number, pitch_target);
+		if (mix->epcm->voices[1])
+			snd_emu10k1_ptr_write(emu, PTRX_PITCHTARGET, mix->epcm->voices[1]->number, pitch_target);
+		if (mix->epcm->extra)
+			snd_emu10k1_ptr_write(emu, PTRX_PITCHTARGET, mix->epcm->extra->number, pitch_target);
+	}
+	spin_unlock_irqrestore(&emu->reg_lock, flags);
+        return change;
+}
+
+static snd_kcontrol_new_t snd_emu10k1_pitch_control =
+{
+	access:		SNDRV_CTL_ELEM_ACCESS_READWRITE | SNDRV_CTL_ELEM_ACCESS_INACTIVE,
+        iface:          SNDRV_CTL_ELEM_IFACE_MIXER,
+        name:           "EMU10K1 PCM Pitch",
+        info:           snd_emu10k1_pitch_info,
+        get:            snd_emu10k1_pitch_get,
+        put:            snd_emu10k1_pitch_put
+};
+
