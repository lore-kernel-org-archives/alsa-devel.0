>  		[HDA_PCM_TYPE_SPDIF] = { 1, -1 },
> -		[HDA_PCM_TYPE_HDMI]  = { 3, 7, 8, 9, -1 },
> +		[HDA_PCM_TYPE_HDMI]  = { 3, 7, -1 },
>  		[HDA_PCM_TYPE_MODEM] = { 6, -1 },
>  	};
