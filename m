+	if (delta < 0) {
+		delta +=3D runtime->buffer_size;
+		if (delta < 0) {
+			hw_ptr_error(substream, =

+				     "Unexpected hw_pointer value "
+				     "(stream=3D%i, pos=3D%ld, intr_ptr=3D%ld)\n",
+				     substream->stream, (long)pos,
+				     (long)hw_ptr_interrupt);
+			/* rebase to interrupt position */
+			hw_base =3D new_hw_ptr =3D hw_ptr_interrupt;
+			delta =3D 0;
+		} else {
+			hw_base +=3D runtime->buffer_size;
+			if (hw_base =3D=3D runtime->boundary)
+				hw_base =3D 0;
