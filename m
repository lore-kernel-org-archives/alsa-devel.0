 	SET_SYSTEM_SLEEP_PM_OPS(azx_suspend, azx_resume)
-	SET_RUNTIME_PM_OPS(azx_runtime_suspend, azx_runtime_resume, NULL)
+	// SET_RUNTIME_PM_OPS(azx_runtime_suspend, azx_runtime_resume, NULL)
 };
 
