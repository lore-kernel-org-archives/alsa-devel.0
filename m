+		return -EPIPE;
+	}
+	/* here need to check the avail size in draining because
+	   OSS mmap mode sets stop_threshold as maximum (boundary size). */
+	if (runtime->status->state == SNDRV_PCM_STATE_DRAINING &&
+	    avail >= runtime->buffer_size) {
