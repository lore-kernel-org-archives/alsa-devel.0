> +	/* use known values for that card: interface#1 altsetting#1 */
> +	iface = usb_ifnum_to_if(mixer->chip->dev, 1);
> +	alts = &iface->altsetting[1];
> +	ep = get_endpoint(alts, 0)->bEndpointAddress;
