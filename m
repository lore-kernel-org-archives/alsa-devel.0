>  
>  	if (a->format == AUDIO_CODING_TYPE_LPCM)
> -		snd_print_pcm_bits(a->sample_bits, buf2 + 8, sizeof(buf2 - 8));
> +		snd_print_pcm_bits(a->sample_bits, buf2 + 8, sizeof(buf2) - 8);
>  	else if (a->max_bitrate)
>  		snprintf(buf2, sizeof(buf2),
>  				", max bitrate = %d", a->max_bitrate);
