diff -u -r1.93 ac97_patch.c
--- alsa-kernel/pci/ac97/ac97_patch.c	22 Aug 2005 12:42:23 -0000	1.93
+++ alsa-kernel/pci/ac97/ac97_patch.c	30 Aug 2005 09:58:55 -0000
@@ -2145,8 +2145,13 @@
 	val =3D snd_ac97_read(ac97, 0x7a); /* misc control */
 	if (ac97->id =3D=3D 0x414c4780) /* ALC658 */
 		val &=3D ~(1 << 1); /* Pin 47 is spdif input pin */
-	else /* ALC655 */
-		val |=3D (1 << 1); /* Pin 47 is spdif input pin */
+	else { /* ALC655 */
+		if (ac97->subsystem_vendor =3D=3D 0x1462 &&
+		    ac97->subsystem_device =3D=3D 0x0131) /* MSI laptop */
+			val &=3D ~(1 << 1); /* Pin 47 is EAPD (for internal speaker) */
+		else
+			val |=3D (1 << 1); /* Pin 47 is spdif input pin */
+	}
 	val &=3D ~(1 << 12); /* vref enable */
 	snd_ac97_write_cache(ac97, 0x7a, val);
