> +	value[1] = 0x00;
> +
>  	pval = (struct snd_ftu_eff_switch_priv_val *)
>  		kctl->private_value;
>  
> @@ -630,14 +637,6 @@ static int snd_ftu_eff_switch_get(struct snd_kcontrol *kctl,
