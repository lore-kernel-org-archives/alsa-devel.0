>  		AC_AMP_SET_RIGHT | AC_AMP_SET_LEFT | AC_AMP_SET_OUTPUT |
>  			cxt5066_analog_mic_boost.items[spec->mic_boost].index);
> -	if (spec->ideapad) {
> +	if (spec->ideapad | spec->thinkpad) {

This should be a logical OR.


