> +		if (((int)diff_dac) < 0)
> +			diff_dac = -diff_dac;
> +		score = diff_adc + diff_dac;
> +		return score;
> +	}
> +	return 0xffffffff;

-1 would be simpler and safer (for possible missing f's).

> +}
> +int find_rate(int mclk, u32 need_adc, u32 need_dac)

Use static.

> +{
> +	int i, j;
> +	int best_i = -1;
> +	int best_j = -1;
> +	int best_div = 0;
> +	unsigned best_score = 0xffffffff;

