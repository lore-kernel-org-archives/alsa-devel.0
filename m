> 
> -static void usb6fire_control_master_vol_update(struct control_runtime *rt)
> +static void usb6fire_control_output_vol_update(struct control_runtime *rt)
>  {
>  	struct comm_runtime *comm_rt = rt->chip->comm;
> -	if (comm_rt) {
