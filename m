--- /dev/null
+++ b/sound/soc/sh/fsi-da7210.c
@@ -0,0 +1,117 @@
+/*
+ * fsi-da7210.c
+ *
+ * Copyright (C) 2009 Renesas Solutions Corp.
+ * Kuninori Morimoto <morimoto.kuninori@renesas.com>
