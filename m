+
+	if (!sig_count) {
 		int err;
 		struct sigaction act;
 		memset(&act, 0, sizeof(act));
@@ -116,10 +138,15 @@
 		sigemptyset(&act.sa_mask);
 		err = sigaction(snd_async_signo, &act, NULL);
 		if (err < 0) {
+			err = -errno;
 			SYSERR("sigaction");
-			return -errno;
+			list_del(&(*handler)->glist);
+			free(*handler);
+			*handler = NULL;
