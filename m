>  }
>  
> +static int snd_disconnect_release(struct inode *inode, struct file *file)
> +{
> +	struct snd_monitor_file *df = NULL;
> +	struct list_head *entry;
> +
> +	spin_lock(&shutdown_mutex);
> +	list_for_each(entry, &shutdown_files) {

You can use list_for_each_entry() to remove one more variable.

Otherwise the code looks OK.  Could you fix the above, then I'll merge
to the ALSA tree.


