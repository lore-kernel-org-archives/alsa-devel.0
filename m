+		if (changed++) {
+			if (rmin > fp->channels)
+				rmin = fp->channels;
+			if (rmax < fp->channels)
+				rmax = fp->channels;
+		} else {
+			rmin = fp->channels;
+			rmax = fp->channels;
+		}
+	}
+
+	if (! changed) {
+#ifdef HW_CONST_DEBUG
+		printk(KERN_DEBUG "  --> get empty\n");
+#endif
+		it->empty = 1;
