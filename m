> +		return -ENOMEM;
> +	}
> +
> +	for (i = 0; i < info->opt_master.len; i++) {
> +		names[i] = kmalloc_array(SNDRV_CTL_ELEM_ID_NAME_MAXLEN,
> +				   sizeof(char), GFP_KERNEL);
> +		if (!names[i]) {
> +			kfree(names);
> +			return -ENOMEM;

Memory leaks.  names[0..i-1] have to be freed, too.


