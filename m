 };
 
 /** Callback table of ioplug */
@@ -189,6 +193,10 @@
 	 * get the delay for the running PCM; optional
 	 */
 	int (*delay)(snd_pcm_ioplug_t *io, snd_pcm_sframes_t *delayp);
+	/**
