+#!/bin/sh
+# load the firmware into Tascam USB devices (FPGA design)
+
+prefix=@prefix@
+exec_prefix=@exec_prefix@
+
+LOADER=@bindir@/usx2yloader
+
+if [ -x /usr/bin/logger ]; then
+	/usr/bin/logger -t $0 "calling $LOADER for $DEVICE"
+fi
+$LOADER
+@bin@/us428control &
+if [ -x /usr/bin/logger ]; then
+	/usr/bin/logger -t $0 "leaving"
+fi
+
+exit 0
