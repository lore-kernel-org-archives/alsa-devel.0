> +	snd_printd("hda-bus: start power save monitor\n");
> +	ret = mod_timer(&bus->power_save_timer,
> +			jiffies + \
> +			msecs_to_jiffies(POWER_SAVE_MONITOR_INTERVAL));
> +	if (ret)
> +		snd_printd("hda-bus: error in mod_timer\n");
