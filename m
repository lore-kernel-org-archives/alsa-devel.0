>  
>  static const DECLARE_TLV_DB_SCALE(db_scale_wm_dac, -12700, 100, 1);
> +static const DECLARE_TLV_DB_LINEAR(ak4396_db_scale, TLV_DB_GAIN_MUTE, 0);
