>  sound/sound_firmware.c |    3 +++
>  3 files changed, 5 insertions(+), 5 deletions(-)
> 
> --- linux-2.6.18-rc4-mm2/sound/Makefile.old	2006-08-22 00:07:41.000000000 +0200
