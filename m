> +	/*
> +	 * In the case of ASoC HD-audio, hda_codec is device managed.
> +	 * It will be freed when the ASoC device is removed.
> +	 */
> +	if (codec->core.type == HDA_DEV_LEGACY)
> +		kfree(codec);
>  }
