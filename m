>  void snd_pcm_set_sync(struct snd_pcm_substream *substream);
>  int snd_pcm_lib_interleave_len(struct snd_pcm_substream *substream);
>  int snd_pcm_lib_ioctl(struct snd_pcm_substream *substream,
