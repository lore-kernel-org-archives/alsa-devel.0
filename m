> +						    int channels)
> +{
> +	if (cap->ca_index == 0x00 && channels == 2)
> +		return SNDRV_CTL_TLVT_CHMAP_FIXED;
> +
> +	return hdmi_chmap_cea_alloc_validate_get_type(cap, channels);
