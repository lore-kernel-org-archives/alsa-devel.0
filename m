-		err = sigaction(snd_async_signo, &act, NULL);
-		if (err < 0) {
-			SYSERR("sigaction");
-			return -errno;
+	if (!handler->no_signal) {
+		sig_count--;
+		if (!sig_count) {
+			struct sigaction act;
