> +	ALC255_FIXUP_DELL_SPK_NOISE,
>  };
>  
>  static const struct hda_fixup alc269_fixups[] = {
> @@ -5368,6 +5369,12 @@ static const struct hda_fixup alc269_fixups[] = {
