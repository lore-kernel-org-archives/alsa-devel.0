#!/bin/sh
rm -rf check1
mkdir -p check1
opt=""
case "$1" in
    -*)
	opt="$1"
	shift;;
esac

if [ -z "$1" ]; then
  set codecs/*
fi
for i in $*; do
    f=${i##*/}
    echo q | ./hda-emu $opt -l2 $i > check1/$f 2> /dev/null
done

