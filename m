> +        struct list_head *pos;
> +
> +        list_for_each(pos, &uc_mgr->active_modifiers) {
> +                mod = list_entry(pos, struct use_case_modifier, active_list);
> +                if (strcmp(mod->name, modifier_name) == 0)
> +                        return 1;
> +        }
> +        return 0;
> +}
