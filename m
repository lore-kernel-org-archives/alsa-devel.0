> diff --git a/sound/usb/usbquirks.h b/sound/usb/usbquirks.h
> index e691eba..14552d2 100644
> --- a/sound/usb/usbquirks.h
> +++ b/sound/usb/usbquirks.h
> @@ -2215,6 +2215,51 @@ YAMAHA_DEVICE(0x7010, "UB99"),
>  	}
