> @@ -1980,8 +1985,13 @@ snd_azf3328_timer_stop(struct snd_timer *timer)
>  	chip = snd_timer_chip(timer);
>  	spin_lock_irqsave(&chip->reg_lock, flags);
>  	/* disable timer countdown and interrupt */
