+			kctl->access |= SNDRV_CTL_ELEM_ACCESS_TLV_COEFF;
 			sb = (struct soc_bytes_ext *)kctl->private_value;
 			if (tplg_bc->priv.size)
 				return skl_init_algo_data(
diff --git a/sound/soc/soc-ops.c b/sound/soc/soc-ops.c
