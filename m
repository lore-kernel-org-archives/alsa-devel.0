-		    !component->driver->compress_ops->set_metadata)
-			continue;
-
-		ret = component->driver->compress_ops->set_metadata(
-			component, cstream, metadata);
-		if (ret < 0)
-			return ret;
-	}
+	ret = snd_soc_component_compr_set_metadata(cstream, metadata);
 
-	return 0;
+	return ret;
 }
 
