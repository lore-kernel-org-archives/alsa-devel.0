>  	ALC662_FIXUP_BASS_1A_CHMAP,
> +	ALC668_FIXUP_AUTO_MUTE,
>  };
>  
>  static const struct hda_fixup alc662_fixups[] = {
> @@ -4999,6 +5009,12 @@ static const struct hda_fixup alc662_fixups[] = {
