 sound/soc/generic/audio-graph-card.c | 366 ++++++++++++++++++++++++++++++-----
 2 files changed, 320 insertions(+), 47 deletions(-)

diff --git a/sound/soc/generic/Kconfig b/sound/soc/generic/Kconfig
index fa5aff9..53957824 100644
