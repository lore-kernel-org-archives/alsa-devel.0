 	/* Restore codec state */
 	ret = regcache_sync(cs4271->regmap);
@@ -567,20 +567,20 @@ static int cs4271_soc_resume(struct snd_soc_codec *codec)
 EXPORT_SYMBOL_GPL(cs4271_dt_ids);
 #endif
 
