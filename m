 sound/usb/endpoint.c         |    3 ++-
 sound/usb/helper.c           |    3 ++-
 sound/usb/midi.c             |    3 ++-
 sound/usb/misc/ua101.c       |    2 ++
 sound/usb/pcm.c              |    6 ++++--
 sound/usb/proc.c             |    3 ++-
