-				if (substream->pstr->xrun_debug > 1)
-					dump_stack();
-			}
-#endif
+	hw_base =3D runtime->hw_ptr_base;
+	new_hw_ptr =3D hw_base + pos;
+
+	delta =3D new_hw_ptr - old_hw_ptr;
+	if (delta < 0) {
+		delta +=3D runtime->buffer_size;
+		if (delta < 0) {
+			hw_ptr_error(substream, =

+				     "Unexpected hw_pointer value [2] "
+				     "(stream=3D%i, pos=3D%ld, old_ptr=3D%ld)\n",
+				     substream->stream, (long)pos,
