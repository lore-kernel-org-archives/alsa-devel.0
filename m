 			return 0;
 		}
-		runtime->hw_ptr_base +=3D runtime->buffer_size;
-		if (runtime->hw_ptr_base =3D=3D runtime->boundary)
-			runtime->hw_ptr_base =3D 0;
-		new_hw_ptr =3D runtime->hw_ptr_base + pos;
