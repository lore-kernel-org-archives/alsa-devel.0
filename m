>  		  -e 's,@mydatadir\@,$(mydatadir),g' \
> +		  -e 's,@alsactlhome\@,$(ALSACTL_HOME_DIR),g' \
>  		  -e 's,@daemonswitch\@,$(ALSACTL_DAEMONSWITCH),g' \
