 		dev_err(component->dev, "Invalid Input- gain type:%d\n",
 				mc->type);
 		return -EINVAL;
-	};
+	}
 
 	return 0;
 }
@@ -286,7 +286,7 @@ static int sst_gain_put(struct snd_kcont
