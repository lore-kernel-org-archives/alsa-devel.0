> +
> +		while (id->name[0]) {
> +			if (hdev->vendor_id == id->id)
> +				return id;
> +			id++;
> +		}
> +	}
> +	return NULL;
> +}
> +EXPORT_SYMBOL_GPL(snd_soc_hda_get_device_id);
